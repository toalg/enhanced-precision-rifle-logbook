# Copy this file to .env.development or .env.production and fill in real values.
# DO NOT commit .env.development or .env.production - those are gitignored.
#
# To load a specific env file at build time:
#   ENVFILE=.env.production npx react-native run-ios --configuration Release
# EAS Build profiles handle this automatically via the .env mapping in eas.json.

# -- Application environment ------------------------------------------------
APP_ENV=development

# -- Supabase ---------------------------------------------------------------
# Get these from your Supabase project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_or_eyJ...

# -- Sentry -----------------------------------------------------------------
# DSN from Settings > Projects > [your project] > Client Keys (DSN).
SENTRY_DSN=https://xxxxx@oXXXXXX.ingest.us.sentry.io/XXXXXX
# Auth token for source-map uploads (Org Settings > Auth Tokens, scopes:
# org:read project:read project:releases project:write).
SENTRY_AUTH_TOKEN=

# -- Legal URLs (used by Settings > Legal section) --------------------------
PRIVACY_POLICY_URL=https://precisionriflelogbook.app/privacy
TERMS_OF_SERVICE_URL=https://precisionriflelogbook.app/terms
